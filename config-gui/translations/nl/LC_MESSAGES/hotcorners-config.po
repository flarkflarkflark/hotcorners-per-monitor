#: config-gui/hotcorners_config.py:323 config-gui/hotcorners_config.py:345
#: config-gui/hotcorners_config.py:680 config-gui/hotcorners_config.py:695
msgid "Activity"
msgstr "Activiteit"

#: config-gui/hotcorners_config.py:324 config-gui/hotcorners_config.py:346
#: config-gui/hotcorners_config.py:681 config-gui/hotcorners_config.py:703
msgid "Desktop"
msgstr "Bureaublad"

#: config-gui/hotcorners_config.py:325 config-gui/hotcorners_config.py:347
#: config-gui/hotcorners_config.py:682
msgid "Activity + Desktop"
msgstr "Activiteit + bureaublad"

#: config-gui/hotcorners_config.py:326 config-gui/hotcorners_config.py:1455
msgid "Add Context"
msgstr "Context toevoegen"

#: config-gui/hotcorners_config.py:327 config-gui/hotcorners_config.py:1456
msgid "Edit Context"
msgstr "Context bewerken"

#: config-gui/hotcorners_config.py:328 config-gui/hotcorners_config.py:1457
#: config-gui/hotcorners_config.py:2016
msgid "Remove Context"
msgstr "Context verwijderen"

#: config-gui/hotcorners_config.py:329 config-gui/hotcorners_config.py:1808
msgid "Inherit from Default"
msgstr "Overnemen van standaard"

#: config-gui/hotcorners_config.py:330 config-gui/hotcorners_config.py:1962
#: config-gui/hotcorners_config.py:2002
msgid "A context with this identifier already exists."
msgstr "Er bestaat al een context met deze identificatie."

#: config-gui/hotcorners_config.py:331 config-gui/hotcorners_config.py:2012
msgid "The default context cannot be removed."
msgstr "De standaardcontext kan niet worden verwijderd."

#: config-gui/hotcorners_config.py:332 config-gui/hotcorners_config.py:2017
msgid "Remove this context?"
msgstr "Deze context verwijderen?"

#: config-gui/hotcorners_config.py:333 config-gui/hotcorners_config.py:1957
#: config-gui/hotcorners_config.py:1997 config-gui/hotcorners_config.py:2258
#: config-gui/hotcorners_config.py:2267 config-gui/hotcorners_config.py:2269
#: config-gui/hotcorners_config.py:2272 config-gui/hotcorners_config.py:2286
#: config-gui/hotcorners_config.py:2289
msgid "Invalid context identifier."
msgstr "Ongeldige contextidentificatie."

#: config-gui/hotcorners_config.py:360
#, python-brace-format
msgid "Activity: {activity_id}"
msgstr "Activiteit: {activity_id}"

#: config-gui/hotcorners_config.py:363
#, python-brace-format
msgid "Desktop: {desktop_id}"
msgstr "Bureaublad: {desktop_id}"

#: config-gui/hotcorners_config.py:368
#, python-brace-format
msgid "Activity + Desktop: {activity_id} / {desktop_id}"
msgstr "Activiteit + bureaublad: {activity_id} / {desktop_id}"

#: config-gui/hotcorners_config.py:684
msgid ""
"Choose what this context depends on. The binding you edit here applies only "
"while that activity and/or virtual desktop is current."
msgstr ""
"Kies waarvan deze context afhangt. De koppeling die u hier bewerkt, geldt "
"alleen zolang die activiteit en/of dat virtuele bureaublad actief is."

#: config-gui/hotcorners_config.py:692
msgid ""
"The activity this context applies to. The name is shown; the stable "
"identifier KWin matches on is stored."
msgstr ""
"De activiteit waarop deze context van toepassing is. De naam wordt "
"getoond; de stabiele identificatie waarmee KWin vergelijkt, wordt "
"opgeslagen."

#: config-gui/hotcorners_config.py:700
msgid ""
"The virtual desktop this context applies to. The name is shown; the stable "
"identifier KWin matches on is stored."
msgstr ""
"Het virtuele bureaublad waarop deze context van toepassing is. De naam "
"wordt getoond; de stabiele identificatie waarmee KWin vergelijkt, wordt "
"opgeslagen."

#: config-gui/hotcorners_config.py:706
msgid "Refresh list"
msgstr "Lijst vernieuwen"

#: config-gui/hotcorners_config.py:708
msgid ""
"Look up the current activities and virtual desktops again, for example after "
"creating or renaming one."
msgstr ""
"Zoek de huidige activiteiten en virtuele bureaubladen opnieuw op, "
"bijvoorbeeld nadat er een is aangemaakt of hernoemd."

#: config-gui/hotcorners_config.py:734
#, python-brace-format
msgid "{identifier} — unavailable"
msgstr "{identifier} — niet beschikbaar"

#: config-gui/hotcorners_config.py:1008
msgid ""
"Runs the action after the cursor has stayed in this hot zone for the linger "
"delay."
msgstr ""
"Voert de actie uit nadat de cursor gedurende de talmvertraging in deze "
"hotzone is gebleven."

#: config-gui/hotcorners_config.py:1013
msgid ""
"Runs the action as soon as the cursor reaches this hot zone, or on a short "
"touch when a linger action is also set."
msgstr ""
"Voert de actie uit zodra de cursor deze hotzone bereikt, of bij een korte "
"aanraking wanneer er ook een talmactie is ingesteld."

#: config-gui/hotcorners_config.py:1019
msgid ""
"No action: nothing happens.\n"
"Trigger shortcut: invokes a KDE global shortcut.\n"
"Command: runs a program directly, without a shell."
msgstr ""
"Geen actie: er gebeurt niets.\n"
"Sneltoets activeren: roept een globale KDE-sneltoets aan.\n"
"Opdracht: start een programma rechtstreeks, zonder shell."

#: config-gui/hotcorners_config.py:1032 config-gui/hotcorners_config.py:1809
msgid "No action"
msgstr "Geen actie"

#: config-gui/hotcorners_config.py:1033 config-gui/hotcorners_config.py:1810
msgid "Trigger shortcut"
msgstr "Sneltoets uitvoeren"

#: config-gui/hotcorners_config.py:1037
msgid "Action:"
msgstr "Actie:"

#: config-gui/hotcorners_config.py:1042
msgid "Custom shortcut…"
msgstr "Aangepaste sneltoets…"

#: config-gui/hotcorners_config.py:1044
msgid ""
"The KDE global shortcut to invoke. Choose \"Custom shortcut…\" to enter one "
"that is not in this list."
msgstr ""
"De globale KDE-sneltoets die wordt aangeroepen. Kies „Aangepaste "
"sneltoets…” om er een in te voeren die niet in deze lijst staat."

#: config-gui/hotcorners_config.py:1048
msgid "Shortcut:"
msgstr "Sneltoets:"

#: config-gui/hotcorners_config.py:1052
msgid "e.g. kwin"
msgstr "bijv. kwin"

#: config-gui/hotcorners_config.py:1054
msgid ""
"The kglobalaccel component that owns the shortcut, such as kwin for window "
"management or ksmserver for session actions."
msgstr ""
"De kglobalaccel-component waartoe de sneltoets behoort, zoals kwin voor "
"vensterbeheer of ksmserver voor sessiehandelingen."

#: config-gui/hotcorners_config.py:1058
msgid "Component:"
msgstr "Component:"

#: config-gui/hotcorners_config.py:1062
msgid "e.g. Overview"
msgstr "bijv. Overview"

#: config-gui/hotcorners_config.py:1064
msgid ""
"The exact shortcut name within that component. It must match how KDE "
"registered it, including spelling and spaces."
msgstr ""
"De exacte sneltoetsnaam binnen die component. Deze moet precies "
"overeenkomen met de manier waarop KDE deze heeft geregistreerd, inclusief "
"spelling en spaties."

#: config-gui/hotcorners_config.py:1068
msgid "Shortcut name:"
msgstr "Sneltoetsnaam:"

#: config-gui/hotcorners_config.py:1073
msgid ""
"The program to run. Give a full path, or a bare name to be found on PATH. It "
"is executed directly, without a shell, so pipes, redirections and variables "
"are not interpreted."
msgstr ""
"Het uit te voeren programma. Geef een volledig pad op, of een kale naam "
"die via PATH wordt gevonden. Het wordt rechtstreeks uitgevoerd, zonder "
"shell, dus pipes, omleidingen en variabelen worden niet geïnterpreteerd."

#: config-gui/hotcorners_config.py:1084
msgid ""
"Arguments passed to the program, one entry per argument, in this order. "
"Because no shell is involved, each entry is passed through literally: do not "
"quote them, and spaces do not split an entry."
msgstr ""
"Argumenten die aan het programma worden doorgegeven, één item per "
"argument, in deze volgorde. Omdat er geen shell bij betrokken is, wordt "
"elk item letterlijk doorgegeven: gebruik geen aanhalingstekens, en "
"spaties splitsen een item niet op."

#: config-gui/hotcorners_config.py:1102
msgid "Add one argument to the end of the list."
msgstr "Voeg één argument toe aan het einde van de lijst."

#: config-gui/hotcorners_config.py:1103
msgid "Change the selected argument."
msgstr "Wijzig het geselecteerde argument."

#: config-gui/hotcorners_config.py:1104
msgid "Delete the selected argument."
msgstr "Verwijder het geselecteerde argument."

#: config-gui/hotcorners_config.py:1105
msgid "Move the selected argument one place earlier."
msgstr "Verplaats het geselecteerde argument één plaats naar voren."

#: config-gui/hotcorners_config.py:1106
msgid "Move the selected argument one place later."
msgstr "Verplaats het geselecteerde argument één plaats naar achteren."

#: config-gui/hotcorners_config.py:1324
msgid "Pushing the cursor against this corner/edge does nothing."
msgstr "De cursor tegen deze hoek/rand duwen doet niets."

#: config-gui/hotcorners_config.py:1328
msgid ""
"Find shortcut names with: <code>qdbus6 org.kde.kglobalaccel /component/"
"&lt;component&gt; org.kde.kglobalaccel.Component.shortcutNames</code>"
msgstr ""
"Vind sneltoetsnamen via: <code>qdbus6 org.kde.kglobalaccel /component/"
"&lt;component&gt; org.kde.kglobalaccel.Component.shortcutNames</code>"

#: config-gui/hotcorners_config.py:1339
msgid ""
"The selected shortcut will be invoked when the cursor is pushed against this "
"corner/edge."
msgstr ""
"De gekozen sneltoets wordt uitgevoerd wanneer de cursor tegen deze hoek/rand "
"wordt geduwd."

#: config-gui/hotcorners_config.py:1375
msgid "Hot Corners Per Monitor"
msgstr "Hot Corners per Monitor"

#: config-gui/hotcorners_config.py:1406
msgid ""
"<b>Tip:</b> Disable the standard KDE hot corners in System Settings → Screen "
"Edges before relying on this script, otherwise both will fire."
msgstr ""
"<b>Tip:</b> Schakel de standaard KDE hot corners eerst uit in "
"Systeeminstellingen → Schermranden, anders triggeren beide tegelijk."

#: config-gui/hotcorners_config.py:1424
msgid "Monitor arrangement — click a corner or edge to configure"
msgstr "Monitor-indeling — klik op een hoek of rand om te configureren"

#: config-gui/hotcorners_config.py:1431
msgid ""
"Your monitors, arranged as they are on your desk. Click one of the eight "
"handles on a monitor — four corners and four edge midpoints — to choose "
"which hot zone to configure. Filled handles already have an action."
msgstr ""
"Uw monitoren, gerangschikt zoals op uw bureau. Klik op een van de acht "
"grepen op een monitor — vier hoeken en vier randmiddens — om te kiezen "
"welke hotzone u wilt instellen. Gevulde grepen hebben al een actie."

#: config-gui/hotcorners_config.py:1440
msgid "Select a corner above"
msgstr "Kies een hoek hierboven"

#: config-gui/hotcorners_config.py:1448
msgid ""
"Which situation you are editing bindings for. \"Default\" applies whenever "
"no more specific context matches; the others apply only in their own "
"activity and/or virtual desktop."
msgstr ""
"Voor welke situatie u koppelingen bewerkt. „Standaard” geldt wanneer geen "
"specifiekere context van toepassing is; de andere gelden alleen binnen "
"hun eigen activiteit en/of virtuele bureaublad."

#: config-gui/hotcorners_config.py:1459
msgid ""
"Create a context for a specific activity, virtual desktop, or both, so this "
"monitor's hot zones can behave differently there."
msgstr ""
"Maak een context voor een specifieke activiteit, virtueel bureaublad, of "
"beide, zodat de hotzones van deze monitor zich daar anders kunnen "
"gedragen."

#: config-gui/hotcorners_config.py:1463
msgid ""
"Change which activity or virtual desktop the selected context applies to. "
"The Default context cannot be changed."
msgstr ""
"Wijzig voor welke activiteit of virtueel bureaublad de geselecteerde "
"context geldt. De standaardcontext kan niet worden gewijzigd."

#: config-gui/hotcorners_config.py:1467
msgid ""
"Delete the selected context and all bindings in it. Those hot zones then "
"fall back to the Default context."
msgstr ""
"Verwijdert de geselecteerde context en alle koppelingen daarin. Die "
"hotzones vallen dan terug op de standaardcontext."

#: config-gui/hotcorners_config.py:1479
msgid ""
"When a hot zone triggers, the most specific matching context wins: activity "
"+ desktop, then activity, then desktop, then Default."
msgstr ""
"Wanneer een hotzone wordt geactiveerd, wint de meest specifieke "
"overeenkomende context: activiteit + bureaublad, dan activiteit, dan "
"bureaublad, dan Standaard."

#: config-gui/hotcorners_config.py:1490
msgid ""
"Whether this hot zone has its own binding in this context.\n"
"\n"
"Inherit from Default: no binding here, so the Default context's binding is "
"used.\n"
"Set here: this context overrides Default.\n"
"\n"
"To make a hot zone deliberately do nothing in this context, set it here with "
"the action \"No action\" — that blocks the fallback instead of inheriting."
msgstr ""
"Of deze hotzone een eigen koppeling heeft in deze context.\n"
"\n"
"Overnemen van Standaard: hier geen koppeling, dus wordt de koppeling van "
"de standaardcontext gebruikt.\n"
"Hier instellen: deze context overschrijft Standaard.\n"
"\n"
"Om een hotzone in deze context bewust niets te laten doen, stelt u hier "
"de actie „Geen actie” in — dat blokkeert de terugval in plaats van over "
"te nemen."

#: config-gui/hotcorners_config.py:1530
#, python-brace-format
msgid ""
"How long the cursor must stay in the hot zone before the linger action runs "
"instead of the tap action. {minimum}–{maximum} ms; {default} ms by default."
msgstr ""
"Hoe lang de cursor in de hotzone moet blijven voordat de talmactie wordt "
"uitgevoerd in plaats van de tikactie. {minimum}–{maximum} ms; standaard "
"{default} ms."

#: config-gui/hotcorners_config.py:1562
#, python-brace-format
msgid ""
"Minimum time before this hot zone can trigger again, to stop one sweep of "
"the cursor from firing repeatedly. 0–{maximum} ms; 0 disables the cooldown."
msgstr ""
"Minimale tijd voordat deze hotzone opnieuw kan worden geactiveerd, om te "
"voorkomen dat één beweging van de cursor herhaaldelijk afgaat. "
"0–{maximum} ms; 0 schakelt de afkoeltijd uit."

#: config-gui/hotcorners_config.py:1596
msgid "Enable tap/linger and contexts…"
msgstr "Tik/talmen en contexten inschakelen…"

#: config-gui/hotcorners_config.py:1600
msgid ""
"Upgrade this configuration so each hot zone can have a separate tap and "
"linger action, and so bindings can differ per activity and virtual desktop. "
"Your existing actions and cooldowns are kept exactly as they are."
msgstr ""
"Werk deze configuratie bij zodat elke hotzone een aparte tik- en "
"talmactie kan hebben, en koppelingen per activiteit en virtueel "
"bureaublad kunnen verschillen. Uw bestaande acties en afkoeltijden "
"blijven precies zoals ze zijn."

#: config-gui/hotcorners_config.py:1607
msgid "Help"
msgstr "Help"

#: config-gui/hotcorners_config.py:1610
msgid "Explain hot zones, actions, cooldown, tap and linger, and contexts."
msgstr "Legt hotzones, acties, afkoeltijd, tikken en talmen, en contexten uit."

#: config-gui/hotcorners_config.py:1613
msgid "Reload from disk"
msgstr "Opnieuw inladen"

#: config-gui/hotcorners_config.py:1616
msgid ""
"Discard unsaved changes and read the configuration from kwinrc again. Use "
"this if another program changed the configuration while this window was open."
msgstr ""
"Verwerpt niet-opgeslagen wijzigingen en leest de configuratie opnieuw uit "
"kwinrc. Gebruik dit als een ander programma de configuratie heeft "
"gewijzigd terwijl dit venster open was."

#: config-gui/hotcorners_config.py:1621
msgid "Close"
msgstr "Sluiten"

#: config-gui/hotcorners_config.py:1623
msgid "Close this window. Unsaved changes are discarded."
msgstr "Sluit dit venster. Niet-opgeslagen wijzigingen worden verworpen."

#: config-gui/hotcorners_config.py:1625
msgid "Apply"
msgstr "Toepassen"

#: config-gui/hotcorners_config.py:1628
msgid ""
"Save the configuration to kwinrc and reload the KWin script so the changes "
"take effect. Nothing is written until you do this."
msgstr ""
"Slaat de configuratie op in kwinrc en herlaadt het KWin-script zodat de "
"wijzigingen actief worden. Er wordt niets geschreven totdat u dit doet."

#: config-gui/hotcorners_config.py:1642
msgid ""
"<h3>Hot zones</h3><p>Every monitor has eight hot zones: its four corners and "
"the midpoint of its four edges. Each one is configured separately, so the "
"corners where two monitors meet can be left empty while the outer corners "
"stay useful.</p><h3>Actions</h3><p><b>No action</b> means pushing the cursor "
"there does nothing. <b>Trigger shortcut</b> invokes a KDE global shortcut, "
"such as Overview. <b>Command</b> runs a program directly.</p><p>Commands are "
"run <b>without a shell</b>. The program is executed as given and each "
"argument is passed through literally, so pipes, redirections, wildcards and "
"variables are not interpreted. To use shell features, run a shell "
"explicitly, for example the program <code>/bin/sh</code> with the arguments "
"<code>-c</code> and your command line.</p><h3>Cooldown</h3><p>After a hot "
"zone fires, it ignores further triggers until the cooldown has passed. This "
"stops a single sweep of the cursor from firing an action several times. Set "
"it to 0 to disable it.</p><h3>Tap and linger</h3><p>A hot zone can do two "
"different things. The <b>tap</b> action runs on a short touch. If a "
"<b>linger</b> action is set, holding the cursor in the zone for the linger "
"delay runs that instead. Only one of the two ever runs per visit. With no "
"linger action, the tap action runs immediately.</p><h3>Contexts</"
"h3><p>Bindings can differ per activity and per virtual desktop. When a hot "
"zone triggers, the most specific matching context wins:</p><p><b>activity + "
"desktop → activity → desktop → Default</b></p><p>A hot zone with no binding "
"in the current context falls back to the next one, and finally to "
"<b>Default</b>. To make a hot zone deliberately do nothing in one context, "
"give it the action \"No action\" there: that blocks the fallback, which is "
"different from leaving it unset.</p><p>Contexts are matched on KDE's "
"internal identifiers, so pick activities and desktops from the lists rather "
"than typing names. An entry marked <i>unavailable</i> refers to an activity "
"or desktop that no longer exists; it is kept, not deleted, so nothing is "
"lost if it comes back.</p><h3>Applying changes</h3><p>Nothing is written "
"until you choose Apply. If another program changes the configuration while "
"this window is open, Apply is refused rather than overwriting it — use "
"Reload from disk and redo your change.</p>"
msgstr ""
"<h3>Hotzones</h3><p>Elke monitor heeft acht hotzones: zijn vier hoeken en "
"de middens van zijn vier randen. Elke wordt afzonderlijk ingesteld, "
"zodat de hoeken waar twee monitoren samenkomen leeg kunnen blijven, "
"terwijl de buitenste hoeken bruikbaar blijven.</p><h3>Acties</h3><p>"
"<b>Geen actie</b> betekent dat het duwen van de cursor daarheen niets "
"doet. <b>Sneltoets activeren</b> roept een globale KDE-sneltoets aan, "
"zoals Overzicht. <b>Opdracht</b> start een programma rechtstreeks.</p><p>"
"Opdrachten worden <b>zonder shell</b> uitgevoerd. Het programma wordt "
"precies zo uitgevoerd als opgegeven en elk argument wordt letterlijk "
"doorgegeven, dus pipes, omleidingen, jokertekens en variabelen worden "
"niet geïnterpreteerd. Om shellfuncties te gebruiken, start u expliciet "
"een shell, bijvoorbeeld het programma <code>/bin/sh</code> met de "
"argumenten <code>-c</code> en uw opdrachtregel.</p><h3>Afkoeltijd</h3><p>"
"Nadat een hotzone afgaat, negeert deze verdere activeringen totdat de "
"afkoeltijd is verstreken. Dit voorkomt dat één beweging van de cursor "
"een actie meerdere keren laat afgaan. Zet de waarde op 0 om dit uit te "
"schakelen.</p><h3>Tikken en talmen</h3><p>Een hotzone kan twee "
"verschillende dingen doen. De <b>tik</b>actie loopt bij een korte "
"aanraking. Als er een <b>talm</b>actie is ingesteld, wordt in plaats "
"daarvan die uitgevoerd wanneer de cursor gedurende de talmvertraging in "
"de zone blijft. Er loopt per bezoek altijd maar één van de twee. Zonder "
"talmactie loopt de tikactie meteen.</p><h3>Contexten</h3><p>Koppelingen "
"kunnen per activiteit en per virtueel bureaublad verschillen. Wanneer "
"een hotzone afgaat, wint de meest specifieke overeenkomende context:</p>"
"<p><b>activiteit + bureaublad → activiteit → bureaublad → Standaard</b>"
"</p><p>Een hotzone zonder koppeling in de huidige context valt terug op "
"de volgende, en uiteindelijk op <b>Standaard</b>. Om een hotzone in één "
"context bewust niets te laten doen, geeft u deze daar de actie „Geen "
"actie”: dat blokkeert de terugval, anders dan hem ongewijzigd te laten.</"
"p><p>Contexten worden vergeleken op basis van interne KDE-identificaties, "
"kies activiteiten en bureaubladen dus uit de lijsten in plaats van namen "
"te typen. Een item gemarkeerd als <i>niet beschikbaar</i> verwijst naar "
"een activiteit of bureaublad dat niet meer bestaat; het wordt bewaard, "
"niet verwijderd, zodat niets verloren gaat als het terugkomt.</p><h3>"
"Wijzigingen toepassen</h3><p>Er wordt niets geschreven totdat u Toepassen "
"kiest. Als een ander programma de configuratie wijzigt terwijl dit "
"venster open is, wordt Toepassen geweigerd in plaats van deze te "
"overschrijven — gebruik Opnieuw inladen en voer uw wijziging opnieuw "
"door.</p>"

