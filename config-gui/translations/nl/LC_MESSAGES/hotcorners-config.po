#: config-gui/hotcorners_config.py:145
msgid ""
"The configuration was changed by another program since this window opened "
"it. Your edits were not saved, and nothing was overwritten. Choose \"Reload "
"from disk\" to load the current configuration, then redo your changes."
msgstr ""
"De configuratie is door een ander programma gewijzigd sinds dit venster "
"werd geopend. Uw wijzigingen zijn niet opgeslagen en er is niets "
"overschreven. Kies „Opnieuw inladen” om de huidige configuratie te laden "
"en voer uw wijzigingen opnieuw door."

#: config-gui/hotcorners_config.py:153
#, python-brace-format
msgid ""
"The required KDE tool \"{tool}\" was not found. It is normally part of "
"Plasma 6. Nothing was changed. Install it, then try again."
msgstr ""
"Het vereiste KDE-hulpprogramma „{tool}” is niet gevonden. Het maakt "
"normaal deel uit van Plasma 6. Er is niets gewijzigd. Installeer het en "
"probeer het opnieuw."

#: config-gui/hotcorners_config.py:159 config-gui/hotcorners_config.py:166
msgid "no further detail was reported"
msgstr "er zijn geen verdere details gemeld"

#: config-gui/hotcorners_config.py:161
#, python-brace-format
msgid ""
"Writing the configuration to kwinrc failed, so nothing was changed. Details: "
"{detail}"
msgstr ""
"Het schrijven van de configuratie naar kwinrc is mislukt, dus er is niets "
"gewijzigd. Details: {detail}"

#: config-gui/hotcorners_config.py:168
#, python-brace-format
msgid ""
"The configuration could not be prepared for saving, so nothing was changed. "
"Details: {detail}"
msgstr ""
"De configuratie kon niet worden voorbereid om op te slaan, dus er is "
"niets gewijzigd. Details: {detail}"

#: config-gui/hotcorners_config.py:172
msgid "Saving the configuration failed. Nothing was changed."
msgstr "Opslaan van de configuratie is mislukt. Er is niets gewijzigd."

#: config-gui/hotcorners_config.py:276
msgid "Overview (show all windows)"
msgstr "Overview (alle vensters tonen)"

#: config-gui/hotcorners_config.py:277
