msgstr "Toepassingsstarter"

#: config-gui/hotcorners_config.py:285
msgid "Show plasma menu at cursor"
msgstr "Plasma-menu tonen bij cursor"

#: config-gui/hotcorners_config.py:286
msgid "Lock screen"
msgstr "Scherm vergrendelen"

#: config-gui/hotcorners_config.py:287
