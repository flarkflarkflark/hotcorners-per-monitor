msgstr "De opdrachtactie start het programma met argv-items exact zoals getoond."

#: config-gui/hotcorners_config.py:213 config-gui/hotcorners_config.py:1000
msgid "Command program cannot be empty."
msgstr "Opdrachtprogramma mag niet leeg zijn."

#: config-gui/hotcorners_config.py:214 config-gui/hotcorners_config.py:1000
msgid "Command program is invalid."
msgstr "Opdrachtprogramma is ongeldig."

#: config-gui/hotcorners_config.py:215 config-gui/hotcorners_config.py:1004
msgid "Command arguments are invalid."
msgstr "Opdrachtargumenten zijn ongeldig."

