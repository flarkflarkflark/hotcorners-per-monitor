msgstr "Der Standardkontext kann nicht entfernt werden."

#: config-gui/hotcorners_config.py:448 config-gui/hotcorners_config.py:2224
msgid "Remove this context?"
msgstr "Diesen Kontext entfernen?"

#: config-gui/hotcorners_config.py:449 config-gui/hotcorners_config.py:2164
#: config-gui/hotcorners_config.py:2204 config-gui/hotcorners_config.py:2465
#: config-gui/hotcorners_config.py:2474 config-gui/hotcorners_config.py:2476
