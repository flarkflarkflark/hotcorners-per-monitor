#: config-gui/hotcorners_config.py:326 config-gui/hotcorners_config.py:1455
msgid "Add Context"
msgstr "Kontext hinzufügen"

#: config-gui/hotcorners_config.py:327 config-gui/hotcorners_config.py:1456
msgid "Edit Context"
msgstr "Kontext bearbeiten"

#: config-gui/hotcorners_config.py:328 config-gui/hotcorners_config.py:1457
#: config-gui/hotcorners_config.py:2016
msgid "Remove Context"
