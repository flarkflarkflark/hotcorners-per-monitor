msgid "Bottom-right"
msgstr "Unten rechts"

#: config-gui/hotcorners_config.py:208 config-gui/hotcorners_config.py:542
msgid "Command"
msgstr "Befehl"

#: config-gui/hotcorners_config.py:208 config-gui/hotcorners_config.py:568
msgid "Program"
msgstr "Programm"

#: config-gui/hotcorners_config.py:208 config-gui/hotcorners_config.py:573
msgid "Arguments"
msgstr "Argumente"

#: config-gui/hotcorners_config.py:209 config-gui/hotcorners_config.py:581
msgid "Add"
msgstr "Hinzufügen"

#: config-gui/hotcorners_config.py:209 config-gui/hotcorners_config.py:582
msgid "Edit"
msgstr "Bearbeiten"

#: config-gui/hotcorners_config.py:209 config-gui/hotcorners_config.py:583
msgid "Remove"
msgstr "Entfernen"

#: config-gui/hotcorners_config.py:209 config-gui/hotcorners_config.py:584
msgid "Move Up"
msgstr "Nach oben"

#: config-gui/hotcorners_config.py:209 config-gui/hotcorners_config.py:585
msgid "Move Down"
msgstr "Nach unten"

#: config-gui/hotcorners_config.py:210 config-gui/hotcorners_config.py:756
#: config-gui/hotcorners_config.py:767
msgid "Argument"
msgstr "Argument"

#: config-gui/hotcorners_config.py:211 config-gui/hotcorners_config.py:756
#: config-gui/hotcorners_config.py:768
msgid "Enter argument value:"
msgstr "Argumentwert eingeben:"

#: config-gui/hotcorners_config.py:212 config-gui/hotcorners_config.py:814
msgid "Command action runs the program with argv items exactly as listed."
msgstr "Die Befehlsaktion startet das Programm mit argv-Einträgen genau wie aufgelistet."

#: config-gui/hotcorners_config.py:213 config-gui/hotcorners_config.py:1000
msgid "Command program cannot be empty."
msgstr "Befehlsprogramm darf nicht leer sein."

#: config-gui/hotcorners_config.py:214 config-gui/hotcorners_config.py:1000
msgid "Command program is invalid."
msgstr "Befehlsprogramm ist ungültig."

#: config-gui/hotcorners_config.py:215 config-gui/hotcorners_config.py:1004
msgid "Command arguments are invalid."
msgstr "Befehlsargumente sind ungültig."

#: config-gui/hotcorners_config.py:217 config-gui/hotcorners_config.py:938
msgid "Cooldown"
msgstr "Abkühlzeit"

#: config-gui/hotcorners_config.py:218 config-gui/hotcorners_config.py:938
msgid "Minimum time before this hot zone can trigger again."
msgstr "Mindestzeit, bevor diese Hot-Zone erneut ausgelöst werden kann."

#: config-gui/hotcorners_config.py:219 config-gui/hotcorners_config.py:1012
msgid "Invalid cooldown value."
msgstr "Ungültiger Abkühlzeitwert."

#: config-gui/hotcorners_config.py:540
msgid "No action"
msgstr "Keine Aktion"

#: config-gui/hotcorners_config.py:541
msgid "Trigger shortcut"
msgstr "Kurzbefehl ausführen"

#: config-gui/hotcorners_config.py:544
msgid "Action:"
msgstr "Aktion:"

#: config-gui/hotcorners_config.py:549
msgid "Custom shortcut…"
msgstr "Benutzerdefinierter Kurzbefehl…"

#: config-gui/hotcorners_config.py:551
msgid "Shortcut:"
msgstr "Kurzbefehl:"

#: config-gui/hotcorners_config.py:555
msgid "e.g. kwin"
msgstr "z. B. kwin"

#: config-gui/hotcorners_config.py:557
msgid "Component:"
msgstr "Komponente:"

#: config-gui/hotcorners_config.py:561
msgid "e.g. Overview"
msgstr "z. B. Overview"

#: config-gui/hotcorners_config.py:563
msgid "Shortcut name:"
msgstr "Kurzbefehlname:"

#: config-gui/hotcorners_config.py:803
msgid "Pushing the cursor against this corner/edge does nothing."
msgstr "Den Mauszeiger gegen diese Ecke/Kante zu drücken bewirkt nichts."

#: config-gui/hotcorners_config.py:807
msgid ""
"Find shortcut names with: <code>qdbus6 org.kde.kglobalaccel /component/"
"&lt;component&gt; org.kde.kglobalaccel.Component.shortcutNames</code>"
msgstr ""
"Kurzbefehlnamen finden mit: <code>qdbus6 org.kde.kglobalaccel /component/"
"&lt;component&gt; org.kde.kglobalaccel.Component.shortcutNames</code>"

#: config-gui/hotcorners_config.py:818
msgid ""
"The selected shortcut will be invoked when the cursor is pushed against this "
"corner/edge."
msgstr ""
"Der ausgewählte Kurzbefehl wird ausgeführt, wenn der Mauszeiger gegen diese "
"Ecke/Kante gedrückt wird."

#: config-gui/hotcorners_config.py:854
msgid "Hot Corners Per Monitor"
msgstr "Aktive Bildschirmecken pro Monitor"

#: config-gui/hotcorners_config.py:877
msgid ""
"<b>Tip:</b> Disable the standard KDE hot corners in System Settings → Screen "
"Edges before relying on this script, otherwise both will fire."
msgstr ""
"<b>Tipp:</b> Deaktivieren Sie zuerst die Standard-KDE-Bildschirmecken in "
"Systemeinstellungen → Bildschirmränder, sonst werden beide ausgelöst."

#: config-gui/hotcorners_config.py:895
msgid "Monitor arrangement — click a corner or edge to configure"
msgstr ""
"Monitor-Anordnung — klicken Sie auf eine Ecke oder Kante zum Konfigurieren"

#: config-gui/hotcorners_config.py:905
msgid "Select a corner above"
msgstr "Wählen Sie eine Ecke oben aus"

#: config-gui/hotcorners_config.py:925
msgid "Reload from disk"
msgstr "Vom Datenträger neu laden"

#: config-gui/hotcorners_config.py:928
msgid "Close"
msgstr "Schließen"

#: config-gui/hotcorners_config.py:931
msgid "Apply"
msgstr "Anwenden"

#: config-gui/hotcorners_config.py:949
#, python-brace-format
msgid "{position} of {monitor}"
msgstr "{position} von {monitor}"

#: config-gui/hotcorners_config.py:1012 config-gui/hotcorners_config.py:1028
msgid "Save failed"
msgstr "Speichern fehlgeschlagen"

#: config-gui/hotcorners_config.py:1022
msgid "Saved"
msgstr "Gespeichert"

#: config-gui/hotcorners_config.py:1023
msgid ""
"Configuration saved. KWin has been reloaded — your changes are active now."
msgstr ""
"Konfiguration gespeichert. KWin wurde neu geladen — Ihre Änderungen sind "
"jetzt aktiv."

#: config-gui/hotcorners_config.py:1029
msgid ""
"Could not write the configuration. Check that kwriteconfig6 is available on "
"your system."
msgstr ""
"Konfiguration konnte nicht geschrieben werden. Prüfen Sie, ob kwriteconfig6 "
"auf Ihrem System verfügbar ist."

